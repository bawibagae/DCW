# Select mysql in production. SQLite remains available for local development.
DATABASE_URL=mysql://dutchpay:change-me@127.0.0.1:3306/dutchpay?charset=utf8mb4
# Or set the fields below instead of DATABASE_URL.
# DB_ENGINE=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=dutchpay
# MYSQL_USER=dutchpay
# MYSQL_PASSWORD=change-me

# Required in production: use a long random value, never commit a real secret.
DUTCHPAY_WEBHOOK_SECRET=replace-with-a-long-random-secret
GOOGLE_SERVICE_ACCOUNT_JSON=
API_BASE_URL=http://localhost:5000
WEB_URL=http://localhost:5000/landing
